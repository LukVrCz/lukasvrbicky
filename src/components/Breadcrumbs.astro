---
import { site } from '@/data/site';
const { items = [] } = Astro.props;
const all = [{ label: 'Úvod', href: '/' }, ...items];
const schema = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: all.map((item, index) => ({ '@type': 'ListItem', position: index + 1, name: item.label, item: new URL(item.href, site.url).toString() })) };
---
<nav aria-label="Drobečková navigace" class="mb-8 text-sm text-muted">
  <ol class="flex flex-wrap gap-2">
    {all.map((item, index) => <li>{index > 0 && <span class="mr-2">/</span>}<a class="hover:text-wine" href={item.href}>{item.label}</a></li>)}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
