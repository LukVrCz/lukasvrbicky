---
const { step, index } = Astro.props;
const Icon = step.icon;
---
<div class="card reveal p-6">
  <p class="font-display text-5xl text-wine/25">0{index + 1}</p>
  <Icon class="mt-7 size-7 text-wine" />
  <h2 class="mt-7 text-xl font-black">{step.cz}</h2>
  <p class="mt-3 text-sm leading-6 text-muted">{step.text}</p>
</div>
