---
import '../styles/global.css';
import { Menu, Instagram, Youtube, Facebook } from '@lucide/astro';
import { site, nav } from '@/data/site';
const {
  title,
  description = site.description,
  canonical = Astro.url.pathname,
  image = '/og.svg',
  type = 'website',
  noindex = false
} = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.tagline}`;
const url = new URL(canonical, site.url).toString();
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${site.url}/#business`,
  name: site.name,
  url: site.url,
  image: new URL(image, site.url).toString(),
  email: site.email,
  telephone: site.phone,
  address: site.address,
  priceRange: '16800 CZK - 26800 CZK',
  sameAs: site.sameAs
};
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#4b0f16" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={url} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={new URL(image, site.url).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-ivory focus:px-5 focus:py-3">Přeskočit na obsah</a>
    <header class="fixed inset-x-0 top-0 z-50 py-4">
      <div class="container">
        <nav class="flex items-center justify-between rounded-full border border-wine/10 bg-ivory/88 px-4 py-3 shadow-[0_12px_48px_rgb(23_19_18/.08)] backdrop-blur-xl" aria-label="Hlavní navigace">
          <a href="/" class="font-display text-2xl font-semibold text-wine" aria-label="Lukáš Vrbický — úvod">Lukáš Vrbický</a>
          <div class="hidden items-center gap-1 lg:flex">
            {nav.map((item) => <a class="rounded-full px-3 py-2 text-sm font-bold text-ink/78 transition hover:bg-sand/60 hover:text-wine" href={item.href}>{item.label}</a>)}
          </div>
          <div class="flex items-center gap-2">
            <a class="btn btn-primary hidden min-h-0 px-4 py-2 text-sm md:inline-flex" href="/kontakt/">Ověřit termín</a>
            <button class="grid size-11 place-items-center rounded-full border border-wine/15 lg:hidden" aria-label="Otevřít menu" data-menu-button><Menu class="size-5" /></button>
          </div>
        </nav>
        <div class="mt-3 hidden rounded-[1.5rem] border border-wine/10 bg-ivory p-3 shadow-soft lg:hidden" data-mobile-menu>
          {nav.map((item) => <a class="block rounded-xl px-4 py-3 font-bold hover:bg-sand/60" href={item.href}>{item.label}</a>)}
        </div>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="bg-ink py-16 text-ivory md:py-24">
      <div class="container grid gap-12 lg:grid-cols-[1.1fr_.8fr_.7fr]">
        <div>
          <p class="eyebrow text-sand">Filmová produkce</p>
          <h2 class="font-display mt-4 text-5xl font-semibold leading-none">{site.name}</h2>
          <p class="mt-6 max-w-md leading-8 text-ivory/68">{site.description}</p>
          <div class="mt-8 flex gap-3">
            <a href={site.sameAs[0]} aria-label="Instagram" class="grid size-11 place-items-center rounded-full bg-white/10 hover:bg-white/20"><Instagram class="size-5" /></a>
            <a href={site.sameAs[1]} aria-label="Facebook" class="grid size-11 place-items-center rounded-full bg-white/10 hover:bg-white/20"><Facebook class="size-5" /></a>
            <a href={site.sameAs[2]} aria-label="YouTube" class="grid size-11 place-items-center rounded-full bg-white/10 hover:bg-white/20"><Youtube class="size-5" /></a>
          </div>
        </div>
        <div>
          <h3 class="font-bold text-white">Kontakt</h3>
          <address class="mt-5 not-italic leading-8 text-ivory/70">
            {site.address}<br />
            <a href={`tel:${site.phone.replaceAll(' ', '')}`}>{site.phone}</a><br />
            <a href={`mailto:${site.email}`}>{site.email}</a><br />
            IČO: {site.ico}
          </address>
        </div>
        <div>
          <h3 class="font-bold text-white">Navigace</h3>
          <div class="mt-5 grid grid-cols-2 gap-3 text-sm text-ivory/70">
            {nav.map((item) => <a class="hover:text-white" href={item.href}>{item.label}</a>)}
            <a class="hover:text-white" href="/faq/">FAQ</a>
            <a class="hover:text-white" href="/gdpr/">GDPR</a>
            <a class="hover:text-white" href="/lokality/">Lokality</a>
          </div>
        </div>
      </div>
    </footer>
    <script>
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      gsap.registerPlugin(ScrollTrigger);
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.querySelector('[data-menu-button]')?.addEventListener('click', () => document.querySelector('[data-mobile-menu]')?.classList.toggle('hidden'));
      if (!reduce) {
        gsap.utils.toArray('.reveal').forEach((el, index) => {
          gsap.to(el, { opacity: 1, y: 0, duration: .85, delay: Math.min(index * .025, .16), ease: 'power3.out', scrollTrigger: { trigger: el, start: 'top 86%' } });
        });
        gsap.to('[data-parallax]', { yPercent: 10, ease: 'none', scrollTrigger: { trigger: '[data-hero]', start: 'top top', end: 'bottom top', scrub: true } });
      }
    </script>
  </body>
</html>
