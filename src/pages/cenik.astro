---
import BaseLayout from '@/layouts/BaseLayout.astro';import Breadcrumbs from '@/components/Breadcrumbs.astro';import CTA from '@/components/CTA.astro';import { packages, packageIncludes } from '@/data/site';import { CheckCircle2 } from '@lucide/astro';
---
<BaseLayout title="Ceník svatebního videa" description="Ceník pouze pro svatební video: Video A 8 hodin 16 800 Kč, Video B 10 hodin 21 800 Kč, Video C 12 hodin 26 800 Kč. Fotografie a reality individuálně."><section class="section pt-36"><div class="container"><Breadcrumbs items={[{label:'Ceník',href:'/cenik/'}]} /><p class="eyebrow">Pricing</p><h1 class="font-display mt-4 max-w-5xl text-6xl font-semibold leading-[.9] md:text-8xl">Tři balíčky. Jediný rozdíl je délka natáčení.</h1><p class="lead mt-7">Ceník je pouze pro svatební video. Fotografie, reality a ostatní služby se naceňují individuálně podle rozsahu.</p><div class="mt-14 grid gap-6 lg:grid-cols-3">{packages.map((p)=><article class:list={['card reveal p-8',p.featured&&'bg-wine text-ivory']}><p class:list={['eyebrow',p.featured&&'text-sand']}>{p.featured?'Nejčastější volba':'Svatební video'}</p><h2 class="font-display mt-5 text-5xl">{p.name}</h2><p class="mt-8 text-2xl font-black">{p.hours}</p><p class="mt-2 text-4xl font-black">{p.price}</p><p class:list={['mt-5 leading-7',p.featured?'text-ivory/72':'text-muted']}>{p.note}</p></article>)}</div><div class="mt-14 rounded-[2rem] bg-paper p-8 shadow-soft"><h2 class="font-display text-5xl">Součástí všech balíčků</h2><ul class="mt-8 grid gap-4 md:grid-cols-3">{packageIncludes.map((item)=><li class="flex items-center gap-3 font-bold"><CheckCircle2 class="size-5 text-wine" />{item}</li>)}</ul></div></div></section><CTA title="Nejste si jistí balíčkem?" text="Pošlete harmonogram. Doporučím délku natáčení podle průběhu dne." /></BaseLayout>
