---
import BaseLayout from '@/layouts/BaseLayout.astro';import Breadcrumbs from '@/components/Breadcrumbs.astro';import CTA from '@/components/CTA.astro';
const faqs=[['Jak předáváte hotová videa?','Hotové výstupy předávám online. DVD ani BluRay už nepoužívám.'],['Jak dlouho trvá zpracování?','Zpracování je většinou do 10 dnů podle rozsahu zakázky a sezóny.'],['Jak počítáte cestovné?','Mimo Královéhradecký kraj je cestovné 8 Kč/km.'],['Kolik kameramanů přijede na svatbu?','U svatebního videa přijedeme ve dvou, aby neunikly důležité okamžiky.'],['Nabízíte fotografii a reality v ceníku?','Ne. Fotografie, realitní prezentace a eventy mají individuální cenu podle rozsahu.']];
---
<BaseLayout title="FAQ" description="Časté otázky k online předání, zpracování do 10 dnů, cestovnému 8 Kč/km mimo Královéhradecký kraj a svatebnímu videu."><section class="section pt-36"><div class="container max-w-4xl"><Breadcrumbs items={[{label:'FAQ',href:'/faq/'}]} /><p class="eyebrow">FAQ</p><h1 class="font-display mt-4 text-6xl font-semibold leading-[.9] md:text-8xl">Časté otázky bez zbytečných slov.</h1><div class="mt-12 grid gap-4">{faqs.map(([q,a])=><details class="card p-6"><summary class="cursor-pointer text-lg font-black">{q}</summary><p class="mt-4 leading-7 text-muted">{a}</p></details>)}</div></div></section><CTA title="Máte jinou otázku?" text="Napište mi. Odpovím stručně, jasně a obvykle do 24 hodin." /></BaseLayout>
