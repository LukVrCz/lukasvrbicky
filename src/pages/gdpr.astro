---
import BaseLayout from '@/layouts/BaseLayout.astro';import Breadcrumbs from '@/components/Breadcrumbs.astro';import { site } from '@/data/site';
---
<BaseLayout title="GDPR" description="Informace o zpracování osobních údajů při odeslání poptávkového formuláře na webu Lukáš Vrbický."><section class="section pt-36"><div class="container max-w-4xl"><Breadcrumbs items={[{label:'GDPR',href:'/gdpr/'}]} /><p class="eyebrow">Privacy</p><h1 class="font-display mt-4 text-6xl font-semibold leading-[.9] md:text-8xl">Ochrana osobních údajů.</h1><div class="prose-rich mt-10"><h2>Správce údajů</h2><p>Správcem osobních údajů je {site.name}, IČO {site.ico}, {site.address}. Kontakt: {site.email}.</p><h2>Účel zpracování</h2><p>Údaje z kontaktního formuláře používám výhradně k vyřízení poptávky, obchodní komunikaci a přípravě nabídky.</p><h2>Doba uchování</h2><p>Údaje uchovávám po dobu nezbytnou k vyřízení komunikace a případné spolupráce podle zákonných povinností.</p></div></div></section></BaseLayout>
