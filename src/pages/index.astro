---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import CTA from '@/components/CTA.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import StepCard from '@/components/StepCard.astro';
import { services, processSteps, reviews } from '@/data/site';
import { getCollection } from 'astro:content';
import { ArrowRight, CheckCircle2 } from 'lucide-astro';
const projects = (await getCollection('portfolio')).filter((project) => project.data.featured).slice(0, 3);
---
<BaseLayout title="Svatební videa, reality a eventy" description="Prémiová filmová produkce Lukáš Vrbický. Svatební videa, svatební fotografie, maturitní plesy, realitní prezentace, komerční videa a eventy.">
  <section data-hero class="relative min-h-screen overflow-hidden bg-ink text-ivory">
    <div data-parallax class="absolute inset-0 bg-[linear-gradient(90deg,rgba(23,19,18,.88),rgba(23,19,18,.36)),radial-gradient(circle_at_72%_30%,rgba(101,24,36,.95),transparent_30%),linear-gradient(135deg,#171312,#4b0f16_52%,#e9dece)]"></div>
    <div class="absolute inset-x-0 bottom-0 h-48 bg-gradient-to-t from-ivory to-transparent"></div>
    <div class="container relative flex min-h-screen items-end pb-20 pt-36 md:pb-28">
      <div class="max-w-5xl">
        <p class="eyebrow text-sand">Cinematic films · weddings · real estate · events</p>
        <h1 class="font-display mt-5 text-6xl font-semibold leading-[.88] md:text-8xl lg:text-9xl">Vzpomínky natočené jako tichý filmový luxus.</h1>
        <p class="mt-8 max-w-2xl text-lg leading-8 text-ivory/76 md:text-xl">Prémiové svatební video, fotografie, realitní prezentace a eventová produkce s důrazem na emoce, světlo, rytmus a nadčasový střih.</p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a class="btn btn-primary bg-ivory text-wine hover:bg-white" href="/kontakt/">Ověřit termín <ArrowRight class="size-4" /></a>
          <a class="btn border border-ivory/30 text-ivory hover:bg-white/10" href="/portfolio/">Portfolio</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeader eyebrow="Služby" title="Každý formát má vlastní rytmus. Výsledek vždy působí filmově." text="Web zachovává současnou strukturu, ale vede návštěvníka plynuleji k ukázkám práce, důvěře a poptávce." />
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {services.map((service) => <ServiceCard service={service} />)}
      </div>
    </div>
  </section>

  <section class="section bg-sand/55">
    <div class="container">
      <SectionHeader eyebrow="Featured Projects" title="Vybrané projekty s důrazem na atmosféru." />
      <div class="grid gap-6 lg:grid-cols-3">{projects.map((project) => <ProjectCard project={project} href={`/portfolio/${project.slug}/`} />)}</div>
      <div class="mt-10 text-center"><a class="btn btn-secondary" href="/portfolio/">Zobrazit celé portfolio</a></div>
    </div>
  </section>

  <section class="section">
    <div class="container grid items-center gap-12 lg:grid-cols-[.9fr_1.1fr]">
      <div class="reveal">
        <p class="eyebrow">About</p>
        <h2 class="font-display mt-4 text-5xl font-semibold leading-[.92] md:text-7xl">Lukáš & Lucie Vrbických</h2>
        <p class="lead mt-7">Jsme manželé, kteří milují nejnovější techniku. Focení a natáčení videí nás oba baví a těšíme se na spolupráci s Vámi. Na place pracujeme klidně, nenápadně a s respektem k lidem před kamerou.</p>
        <div class="mt-8 grid gap-3 text-sm font-bold text-wine md:grid-cols-2">
          {['Kamera · střih · foto · grafika', 'Dva kameramani u svatebního videa', 'Online předání', 'Královéhradecký kraj i celá ČR'].map((item) => <p class="flex items-center gap-3"><CheckCircle2 class="size-5" />{item}</p>)}
        </div>
      </div>
      <div class="reveal media-frame aspect-[4/5] shadow-card"><div class="absolute inset-0 bg-[radial-gradient(circle_at_45%_25%,rgba(251,247,239,.30),transparent_28%),linear-gradient(145deg,#4b0f16,#171312_55%,#e9dece)]"></div></div>
    </div>
  </section>

  <section class="section bg-paper">
    <div class="container">
      <SectionHeader eyebrow="Reviews" title="Důvěra vzniká z klidné práce a silného výsledku." />
      <div class="grid gap-6 md:grid-cols-3">{reviews.map((review) => <blockquote class="card reveal p-8"><p class="text-lg leading-8 text-ink/76">„{review.text}“</p><footer class="mt-8 font-black text-wine">{review.name}</footer></blockquote>)}</div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeader eyebrow="How we work" title="Čtyři jednoduché kroky. Žádný chaos." text="Proces je navržený tak, aby byl pro klienta srozumitelný, klidný a profesionální od první zprávy až po online předání." />
      <div class="grid gap-5 md:grid-cols-4">{processSteps.map((step, index) => <StepCard step={step} index={index} />)}</div>
    </div>
  </section>

  <CTA title="Ověříme váš termín?" text="Stačí krátká zpráva. Doporučím balíček, řeknu dostupnost a navrhnu další krok bez nátlaku." />
</BaseLayout>
