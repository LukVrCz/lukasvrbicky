---
import BaseLayout from '@/layouts/BaseLayout.astro';import Breadcrumbs from '@/components/Breadcrumbs.astro';import HighlightItem from '@/components/HighlightItem.astro';import { site, packages, contactHighlights } from '@/data/site';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '1x00000000000000000000AA';
---
<BaseLayout title="Kontakt" description="Ověřte dostupnost termínu pro svatební video, fotografii, maturitní ples, reality nebo event. Obvykle odpovídám do 24 hodin."><section class="section pt-36"><div class="container"><Breadcrumbs items={[{label:'Kontakt',href:'/kontakt/'}]} /><div class="grid gap-12 lg:grid-cols-[.82fr_1.18fr]"><aside><p class="eyebrow">Contact</p><h1 class="font-display mt-4 text-6xl font-semibold leading-[.9] md:text-8xl">Ověřte termín bez nátlaku.</h1><p class="lead mt-7">Pošlete datum, místo a typ zakázky. Děkuji, obvykle odpovídám do 24 hodin.</p><div class="mt-10 grid gap-4">{contactHighlights.map((item)=><HighlightItem item={item} />)}</div><div class="mt-10 rounded-[2rem] bg-wine p-7 text-ivory"><h2 class="font-display text-4xl">{site.name}</h2><p class="mt-5 leading-8 text-ivory/74">{site.address}<br />IČO: {site.ico}<br />{site.phone}<br />{site.email}</p></div></aside><form method="post" action="/api/contact" class="surface grid gap-4 rounded-[2rem] p-6 md:p-8"><div class="grid gap-4 md:grid-cols-2"><input required name="name" autocomplete="name" placeholder="Jméno" class="rounded-2xl border border-wine/10 bg-white px-5 py-4"/><input required name="phone" autocomplete="tel" placeholder="Telefon" class="rounded-2xl border border-wine/10 bg-white px-5 py-4"/></div><input required type="email" name="email" autocomplete="email" placeholder="Email" class="rounded-2xl border border-wine/10 bg-white px-5 py-4"/><div class="grid gap-4 md:grid-cols-2"><input type="date" name="date" class="rounded-2xl border border-wine/10 bg-white px-5 py-4"/><input name="location" placeholder="Místo" class="rounded-2xl border border-wine/10 bg-white px-5 py-4"/></div><div class="grid gap-4 md:grid-cols-2"><select name="service" class="rounded-2xl border border-wine/10 bg-white px-5 py-4"><option>Svatební video</option><option>Svatební fotografie</option><option>Maturitní ples</option><option>Reality</option><option>Komerční video</option><option>Event</option><option>Sport</option></select><select name="package" class="rounded-2xl border border-wine/10 bg-white px-5 py-4"><option>Individuální cena</option>{packages.map((p)=><option>{p.name} — {p.price}</option>)}</select></div><textarea required name="message" placeholder="Zpráva" rows="7" class="rounded-2xl border border-wine/10 bg-white px-5 py-4"></textarea><label class="flex gap-3 rounded-2xl bg-sand/45 p-4 text-sm leading-6"><input required type="checkbox" name="gdpr"/> Souhlasím se zpracováním osobních údajů pro vyřízení poptávky.</label><div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div><button class="btn btn-primary" type="submit">Odeslat poptávku</button></form></div></div></section><script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script></BaseLayout>
