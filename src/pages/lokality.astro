---
import BaseLayout from '@/layouts/BaseLayout.astro';import Breadcrumbs from '@/components/Breadcrumbs.astro';import CTA from '@/components/CTA.astro';import { getCollection } from 'astro:content';
const venues = (await getCollection('localities')).filter((item) => !item.data.draft);
---
<BaseLayout title="Lokality" description="Architektura pro skutečná svatební místa a lokality. Žádná falešná města — reálná místa budou doplněna postupně."><section class="section pt-36"><div class="container"><Breadcrumbs items={[{label:'Lokality',href:'/lokality/'}]} /><p class="eyebrow">Locations</p><h1 class="font-display mt-4 max-w-5xl text-6xl font-semibold leading-[.9] md:text-8xl">Skutečná místa doplníme až ve chvíli, kdy budou ověřená.</h1><p class="lead mt-7">Stránka je připravená pro svatební místa přes Astro Content Collections. Nepoužívá falešná města ani výplňový obsah.</p>{venues.length ? <div class="mt-12 grid gap-6 md:grid-cols-3">{venues.map((venue)=><article class="card p-7"><h2 class="font-display text-4xl">{venue.data.title}</h2><p class="mt-4 text-muted">{venue.data.description}</p></article>)}</div> : <div class="mt-12 rounded-[2rem] bg-paper p-8 shadow-soft"><h2 class="font-display text-4xl">Připraveno pro reálná svatební místa</h2><p class="mt-4 text-muted">Doplníte je později jako markdown soubory v kolekci <code>localities</code>.</p></div>}</div></section><CTA title="Máte vybrané místo?" text="Pošlete název lokality a datum. Zohledním světlo, logistiku i cestovné." /></BaseLayout>
