---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import YoutubeLite from '@/components/YoutubeLite.astro';
import CTA from '@/components/CTA.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  return (await getCollection('portfolio')).map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const videoSchema = entry.data.youtubeId ? {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: entry.data.title,
  description: entry.data.description,
  thumbnailUrl: `https://i.ytimg.com/vi/${entry.data.youtubeId}/maxresdefault.jpg`,
  uploadDate: entry.data.date,
  embedUrl: `https://www.youtube-nocookie.com/embed/${entry.data.youtubeId}`
} : null;
---
<BaseLayout title={entry.data.title} description={entry.data.description} type="article">
  {videoSchema && <script type="application/ld+json" set:html={JSON.stringify(videoSchema)} />}
  <article class="section pt-36">
    <div class="container max-w-5xl">
      <Breadcrumbs items={[{ label: 'Portfolio', href: '/portfolio/' }, { label: entry.data.title, href: `/portfolio/${entry.slug}/` }]} />
      <p class="eyebrow">{entry.data.category}</p>
      <h1 class="font-display mt-4 text-6xl font-semibold leading-[.9] md:text-8xl">{entry.data.title}</h1>
      <p class="mt-6 text-lg text-muted">{entry.data.location} · {new Date(entry.data.date).getFullYear()}</p>
      <div class="mt-12">{entry.data.youtubeId ? <YoutubeLite id={entry.data.youtubeId} title={entry.data.title} /> : <div class="media-frame aspect-video shadow-card" />}</div>
      <div class="prose-rich mt-12"><Content /></div>
      <div class="mt-10 flex flex-wrap gap-4"><a class="btn btn-primary" href="/kontakt/">Poptat podobný projekt</a><a class="btn btn-secondary" href="/portfolio/">Zpět na portfolio</a></div>
    </div>
  </article>
  <CTA title="Pojďme natočit váš příběh." />
</BaseLayout>
