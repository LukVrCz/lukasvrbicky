---
import BaseLayout from '@/layouts/BaseLayout.astro';import Breadcrumbs from '@/components/Breadcrumbs.astro';import YoutubeLite from '@/components/YoutubeLite.astro';import CTA from '@/components/CTA.astro';
---
<BaseLayout title="Maturitní ples video" description="Aftermovie a kompletní záznam maturitního plesu. Individuální cena, dynamický střih, online předání a důležité momenty večera."><section class="section pt-36"><div class="container"><Breadcrumbs items={[{label:'Portfolio',href:'/portfolio/'},{label:'Maturitní plesy',href:'/portfolio/maturitni-plesy/'}]} /><p class="eyebrow">Graduation balls</p><h1 class="font-display mt-4 max-w-5xl text-6xl font-semibold leading-[.9] md:text-8xl">Maturitní ples jako energický filmový večer.</h1><p class="lead mt-7">Fotografie oživí vzpomínky, ale video vás vrátí zpět do atmosféry večera. Připravíme aftermovie i kompletní záznam programu.</p><div class="mt-12 grid gap-6 lg:grid-cols-2"><YoutubeLite id="XcCOki9Oi90" title="Aftermovie maturitního plesu"/><div class="grid gap-6"><div class="card p-8"><h2 class="font-display text-4xl">Aftermovie</h2><p class="mt-4 text-muted">Krátký dynamický sestřih pro sdílení.</p></div><div class="card p-8"><h2 class="font-display text-4xl">Kompletní záznam</h2><p class="mt-4 text-muted">Nástupy, šerpování, program i důležité momenty večera.</p></div><div class="card p-8"><h2 class="font-display text-4xl">Individuální cena</h2><p class="mt-4 text-muted">Podle rozsahu, místa a požadovaného výstupu.</p></div></div></div></div></section><CTA title="Poptat maturitní ples" text="Pošlete datum, místo a předběžný program. Připravím návrh rozsahu a ceny." /></BaseLayout>
