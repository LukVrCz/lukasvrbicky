---
import BaseLayout from '@/layouts/BaseLayout.astro';import Breadcrumbs from '@/components/Breadcrumbs.astro';import CTA from '@/components/CTA.astro';
const frames=['aspect-[3/4]','aspect-square','aspect-[4/5]','aspect-video','aspect-[5/6]','aspect-[4/3]','aspect-square','aspect-[3/4]','aspect-video'];
---
<BaseLayout title="Svatební fotografie - fotograf na svatbu" description="Prémiová svatební fotografie s velkou galerií, přirozenými momenty, elegantní editací a online předáním."><section class="section pt-36"><div class="container"><Breadcrumbs items={[{label:'Portfolio',href:'/portfolio/'},{label:'Svatební fotografie',href:'/portfolio/svatebni-foto/'}]} /><p class="eyebrow">Wedding Photography</p><h1 class="font-display mt-4 max-w-5xl text-6xl font-semibold leading-[.9] md:text-8xl">Fotografie, které nechávají prostor emocím.</h1><p class="lead mt-7">Galerie je navržená jako velkorysý masonry layout. Konkrétní fotografie doplníte postupně, architektura je připravená pro optimalizované obrázky a lightbox.</p><div class="mt-14 columns-1 gap-5 md:columns-3">{frames.map((frame,i)=><button class:list={['group mb-5 w-full overflow-hidden rounded-[2rem] bg-wine shadow-soft',frame]} data-lightbox aria-label={`Otevřít fotografii ${i+1}`}><span class="block h-full min-h-56 bg-[radial-gradient(circle_at_30%_20%,rgba(251,247,239,.26),transparent_30%),linear-gradient(135deg,#4b0f16,#171312_55%,#e9dece)] transition duration-700 group-hover:scale-105"></span></button>)}</div><p class="mt-10 text-muted">Svatební fotografie se naceňuje individuálně podle rozsahu, místa a termínu.</p></div></section><CTA title="Chcete svatební fotografii?" text="Pošlete datum a místo. Navrhnu rozsah focení a způsob online předání galerie." /><script>document.querySelectorAll('[data-lightbox]').forEach((item)=>item.addEventListener('click',()=>item.classList.toggle('ring-4')));</script></BaseLayout>
