---
import BaseLayout from '@/layouts/BaseLayout.astro';import Breadcrumbs from '@/components/Breadcrumbs.astro';import YoutubeLite from '@/components/YoutubeLite.astro';import CTA from '@/components/CTA.astro';import { reviews } from '@/data/site';import { CheckCircle2 } from 'lucide-astro';
const benefits=['Kompletní záznam příprav, obřadu, gratulací, focení, zábavy a večera','Na svatbu přijedeme ve dvou, aby neunikl důležitý okamžik','Výsledkem je krátký highlight film a dlouhé video','Citlivý přístup, zkušenosti a profesionální technika'];
---
<BaseLayout title="Svatební video - kameraman na svatbu" description="Prémiové svatební video: dva kameramani, kompletní záznam dne, krátký highlight film, dlouhé video, 4K, dron a online předání.">
<section class="section pt-36"><div class="container"><Breadcrumbs items={[{label:'Portfolio',href:'/portfolio/'},{label:'Svatební video',href:'/portfolio/svatebni-video/'}]} /><div class="grid items-end gap-10 lg:grid-cols-[1fr_.72fr]"><div><p class="eyebrow">Wedding Video</p><h1 class="font-display mt-4 text-6xl font-semibold leading-[.9] md:text-8xl">Svatební film, který nepůsobí jako záznam. Působí jako vzpomínka.</h1><p class="lead mt-7">Zachytíme celý svatební den nenápadně, ve dvou kameramanech a s důrazem na skutečné emoce. Výsledkem je krátký film i dlouhé video předané online.</p></div><div class="card p-7"><h2 class="font-display text-4xl">V ceně svatebních balíčků</h2><ul class="mt-6 grid gap-4">{['2 kameramani','4K','dron','krátké video','dlouhé video','online předání'].map(i=><li class="flex gap-3"><CheckCircle2 class="mt-1 size-5 text-wine" />{i}</li>)}</ul></div></div><div class="mt-14"><YoutubeLite id="pVZe8hfnaZs" title="Ukázka svatebního filmu" /></div><div class="mt-14 grid gap-5 md:grid-cols-2">{benefits.map(item=><div class="card p-7"><CheckCircle2 class="size-6 text-wine"/><h2 class="mt-6 text-xl font-black">{item}</h2></div>)}</div><div class="mt-14 grid gap-6 md:grid-cols-3">{reviews.map(r=><blockquote class="card p-7"><p class="leading-7 text-muted">„{r.text}“</p><footer class="mt-6 font-black text-wine">{r.name}</footer></blockquote>)}</div></div></section><CTA title="Máte termín svatby?" text="Pošlete datum a místo. Ověřím dostupnost a doporučím balíček podle harmonogramu dne." /></BaseLayout>
