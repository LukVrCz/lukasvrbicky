---
import BaseLayout from '@/layouts/BaseLayout.astro';import Breadcrumbs from '@/components/Breadcrumbs.astro';import CTA from '@/components/CTA.astro';import { Camera, Video, Plane, Mic2, Captions, Cuboid } from '@lucide/astro';
const items=[['Photography',Camera,'Čisté fotografie exteriéru, interiéru a detailů.'],['Video',Video,'Plynulá prezentace dispozice, atmosféry a hodnoty nemovitosti.'],['Drone',Plane,'Letecké záběry okolí, pozemku a polohy.'],['Voiceover',Mic2,'Komentář pro jasnější prodejní příběh.'],['Captions',Captions,'Titulky pro sledování bez zvuku.'],['Visualizations',Cuboid,'Vizualizace a doplňkové grafické prvky.']];
---
<BaseLayout title="Reality" description="Prémiové realitní foto a video: fotografie, video, dron, voiceover, titulky a vizualizace pro profesionální prodej nemovitostí."><section class="section pt-36"><div class="container"><Breadcrumbs items={[{label:'Reality',href:'/reality/'}]} /><p class="eyebrow">Real Estate</p><h1 class="font-display mt-4 max-w-5xl text-6xl font-semibold leading-[.9] md:text-8xl">Nemovitost musí působit hodnotně ještě před první prohlídkou.</h1><p class="lead mt-7">Realitní prezentace propojuje fotografii, video, dron, komentář, titulky a vizualizace do jasného prodejního příběhu. Cena je individuální podle rozsahu.</p><div class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3">{items.map(([title,Icon,text])=><div class="card reveal p-8"><Icon class="size-7 text-wine"/><h2 class="font-display mt-9 text-4xl">{title}</h2><p class="mt-4 leading-7 text-muted">{text}</p></div>)}</div><div class="mt-14 media-frame aspect-video shadow-card"><div class="absolute inset-0 bg-[radial-gradient(circle_at_72%_35%,rgba(233,222,206,.42),transparent_26%),linear-gradient(135deg,#171312,#4b0f16_55%,#e9dece)]"></div></div></div></section><CTA title="Poptat realitní prezentaci" text="Pošlete typ nemovitosti, lokalitu a rozsah. Připravím individuální návrh produkce." /></BaseLayout>
